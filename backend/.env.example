# ---------------------------------------------------------------- app
PORT=3333
FRONTEND_URL=http://localhost:3000
# Troque por uma string longa e aleatória fora do ambiente local.
JWT_SECRET=dev-only-secret-change-me
SESSION_DAYS=7
COOKIE_SECURE=false

# ---------------------------------------------------------------- banco
# Fase 1: SQLite local. Fase 2 (Supabase): troque o provider do schema.prisma
# para "postgresql", use @prisma/adapter-pg no PrismaService e a URL do Supabase.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------- login
# Google OAuth (console.cloud.google.com → Credenciais → ID do cliente OAuth "Aplicativo da Web").
# URI de redirecionamento autorizado: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Botões "Entrar como cliente/entregador/admin" na tela de login (desligue em produção).
AUTH_DEV_LOGIN=true
# E-mails que viram administradores ao entrar com Google (separados por vírgula).
ADMIN_EMAILS=

# ---------------------------------------------------------------- pagamentos
# fake   → Pix/cartão simulados, com botão "Simular pagamento aprovado"
# stripe → Checkout Sessions + Payment Element (ative Pix e cartões no Dashboard do Stripe)
PAYMENT_PROVIDER=fake
# Prefira uma chave restrita (rk_...) de um sandbox do Stripe.
STRIPE_SECRET_KEY=
# `stripe listen --forward-to localhost:3333/api/webhooks/stripe` mostra o whsec_...
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- WhatsApp
# log  → mensagens aparecem no terminal da API e no painel (Atendente IA)
# zapi → envia de verdade pela Z-API
WHATSAPP_PROVIDER=log
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
# "Token de segurança da conta" (header Client-Token)
ZAPI_CLIENT_TOKEN=
ZAPI_BASE_URL=https://api.z-api.io
# Webhook "ao receber" da instância: https://SEU_DOMINIO/api/webhooks/zapi?secret=ESTE_VALOR
ZAPI_WEBHOOK_SECRET=

# Ritmo da fila de saída do WhatsApp. Uma rajada de mensagens é o que faz o
# número ser limitado ou bloqueado — estes valores são conservadores de
# propósito. Só aumente com uma instância Z-API paga e já "aquecida".
WHATSAPP_MIN_INTERVAL_MS=4000
WHATSAPP_PER_PHONE_INTERVAL_MS=15000
WHATSAPP_PER_MINUTE_LIMIT=12
WHATSAPP_MAX_ATTEMPTS=5
WHATSAPP_BACKOFF_BASE_MS=30000
WHATSAPP_BACKOFF_MAX_MS=1800000
WHATSAPP_QUEUE_TICK_MS=1000

# ------------------------------------------------- e-mail (avisos da administração)
# Pedido pago, cancelado, entregue/retirado e não entregue viram e-mail para os
# usuários ADMIN (e para ADMIN_EMAILS). Ligue/desligue cada aviso no painel, em
# Atendente IA > Avisos automáticos.
# log    → o e-mail aparece no terminal da API
# resend → envia de verdade (https://resend.com)
EMAIL_PROVIDER=log
RESEND_API_KEY=
# Precisa ser de um domínio verificado na conta do Resend.
EMAIL_FROM=Açougue do Vandinho <avisos@acouguedovandinho.com.br>

# ---------------------------------------------------------------- atendente IA (Claude)
# Sem chave, o atendente responde por regras simples (bom para testar o fluxo).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low
ASSISTANT_HISTORY_LIMIT=20

# ---------------------------------------------------------------- outros
UPLOAD_DIR=./uploads
# Geocodificação de endereços via OpenStreetMap (para o mapa do entregador).
GEOCODING_ENABLED=true
